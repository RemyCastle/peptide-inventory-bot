# Required: from @BotFather (primary / legacy single token)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Optional standby pool (different Telegram accounts OK). Comma-separated.
# When the active token is banned/invalid, TOKEN_FAILOVER advances to the next.
# BOT_TOKENS=token_account_A,token_account_B,token_account_C
# ACTIVE_BOT_INDEX=0
# TOKEN_FAILOVER=1
# TOKEN_STATE_PATH=token_state.json

# Comma-separated Telegram user IDs that are global owners
# Get your ID from @userinfobot
OWNER_IDS=123456789

# Instance branding defaults (per-shop overrides live in DB / admin later)
BRAND_NAME=UnicornFartzzBot
CURRENCY=USD
CURRENCY_SYMBOL=$
WELCOME_TEXT=Browse the catalog, add items to your cart, and checkout when ready.

# Default shipping when a new shop is created
DEFAULT_SHIPPING_FEE=8.00
DEFAULT_FREE_SHIPPING_ABOVE=150.00

# Alert admins when stock is at or below this after a paid confirm
DEFAULT_LOW_STOCK_THRESHOLD=2

# Encrypted inventory vault (live DB stays separate). Required for auto snapshots.
# On Render: BACKUP_DIR=/data/backups (Dockerfile + render.yaml). Do not wipe inventory.db.
# BACKUP_PASSPHRASE=long-random-secret-in-password-manager-only
# BACKUP_DIR=backups
# BACKUP_RETENTION_DAYS=30

# Optional public pointer after cutover
# PUBLIC_BOT_USERNAME=YourBotUsername
# RECOVERY_URL=https://yoursite.example/

# Optional paths
# DB_PATH=C:\Users\Remy\peptide_inventory_bot\inventory.db
# LOG_PATH=C:\Users\Remy\peptide_inventory_bot\bot.log

# ── SPBC website integration (supplier notify + catalog sync) ──
# Shared secret with the spbc-orders Cloudflare worker (X-Notify-Secret header)
# NOTIFY_SECRET=same-secret-as-spbc-orders
# Owner chat for placed-order alerts + weekly invoice summary (numeric Telegram id).
# Optional on Unicorn-only deploys: /health default_chat_configured is also
# true when a Unicorn catalog shop is bound in inventory.db. Do not put a
# BotFather token here.
# OWNER_TELEGRAM_CHAT_ID=123456789
# SPBC leftover; unused for Unicorn Magic Factory2. Leave unset.
# SUPPLIER_TELEGRAM_CHAT_ID=
# Storefront whose /api/products feeds the Telegram catalog
# SPBC_SITE_URL=https://springfieldpbc.com
# Bot shop (chat id) that mirrors the website catalog; owner runs /syncsite
# SPBC_SHOP_CHAT_ID=123456789
# Auto-sync every N minutes (0 = manual /syncsite only)
# SITE_SYNC_INTERVAL_MIN=360

# Public URL of this bot service — enables the /webpanel vendor console
# (magic links look like <PANEL_BASE_URL>/panel?t=...)
# Live Unicorn host (do not use suspended spbc-supplier-bot):
# PANEL_BASE_URL=https://unicornfartzz-bot.onrender.com
#
# Pages Mini App catalog key (public read-only; already in
# remy-miniapp-demos.pages.dev/unicorn/). Binds to the live Unicorn shop at boot.
# UNICORN_STOREFRONT_KEY=dd6dec3482e1572886868657
# UNICORN_STORE_URL=https://remy-miniapp-demos.pages.dev/unicorn/

# How long a vendor has to Accept/Decline a fulfillment offer before the
# owner gets nudged with the next-cheapest option (minutes, default 360 = 6h)
# VENDOR_OFFER_TTL_MIN=360

# Where panel-uploaded photos/COA files live (persistent disk on Render)
# MEDIA_DIR=/data/uploads
